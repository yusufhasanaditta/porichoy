# Copy to .env for local development. In production these come from Secret Manager.
GOOGLE_CLOUD_PROJECT=porichoy-abc123
GEMINI_API_KEY=
PSI_API_KEY=            # free: console.cloud.google.com → enable "PageSpeed Insights API" → Credentials → API key
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
ALLOWED_ORIGINS=http://localhost:3000

MODEL_MAIN=gemini-3.8-flash
MODEL_VERIFIER=gemini-3.5-flash-lite  # use gemini-3.1-pro-preview if billing is on
MODEL_LITE=gemini-3.5-flash-lite
MODEL_EMBED=gemini-embedding-001
MODEL_STT=gemini-3.5-transcribe
